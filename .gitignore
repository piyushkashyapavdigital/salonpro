# --- dependencies -----------------------------------------------------------
node_modules/
.pnp
.pnp.js

# --- build output -----------------------------------------------------------
build/
*.tsbuildinfo
coverage/

# --- local database (recreate with `bun run seed:reset`) -------------------
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/uploads/

# Signing material must never be committed.
*.keystore
*.jks
keystore.properties

# --- environment ------------------------------------------------------------
.env
.env.*
!.env.example
# Values to paste into Vercel (see DEPLOY.md) — generated locally, never committed
deploy-secrets.local.txt

# --- editors / OS -----------------------------------------------------------
.idea/
*.iml
.DS_Store
Thumbs.db

# --- APKs -------------------------------------------------------------------
# Build them with `bash scripts/build-mobile-apks.sh`; they are large binaries,
# so hand them out (GitHub releases, Drive) rather than committing them.
artifacts/*.apk
*.cxx/

# --- logs -------------------------------------------------------------------
*.log
bun-debug.log*
