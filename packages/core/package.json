{
  "name": "@salonpro/core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "seed": "bun src/seed.ts",
    "test": "bun test --timeout 120000",
    "typecheck": "tsc --noEmit",
    "seed:reset": "bun src/seed.ts --reset",
    "bootstrap": "bun src/seed.ts --bootstrap",
    "smoke": "bun test test/smoke.test.ts --timeout 120000"
  },
  "dependencies": {
    "@salonpro/shared": "*",
    "pg": "^8.23.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "typescript": "^5.7.2"
  },
  "exports": {
    ".": "./src/server.ts",
    "./*": "./src/*.ts"
  }
}
