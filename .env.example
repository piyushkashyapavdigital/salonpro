# SalonPro environment — copy to `.env` and edit. All values are optional;
# the app runs with zero credentials in clearly-labelled simulated/dev-mock mode.
# Loaded by the API's built-in parser (no dotenv dependency).

# --- Core ---
NODE_ENV=development
PORT=4000
# DATABASE_FILE=./data/salonpro.db

# --- Sessions (rotate SESSION_SECRET to sign everyone out) ---
SESSION_SECRET=dev-session-secret-change-me
SESSION_TTL_DAYS=30

# --- OTP ---
# Leave false to run the labelled development mock (code returned in the response).
# When true, wire a real SMS/WhatsApp provider in services/notifications.ts.
OTP_PROVIDER_CONFIGURED=false
OTP_LENGTH=6
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_PER_HOUR=10

# --- Razorpay ---
# Set both keys to leave simulated mode. Signatures are always verified server-side.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Lets the built-in test checkout post correctly-signed payloads (dev only).
ALLOW_PAYMENT_SIMULATION=true

# --- Notifications (when unset, delivery is recorded as `pending`, never `sent`) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@salonpro.test

# --- Links and browser access ---
# Base URL used in booking/referral message links and the CORS allow-list.
WEB_ORIGIN=http://localhost:5173

# --- Scheduled jobs (reminders on a serverless host) ---
# Shared secret for POST /api/internal/reminders. Unset means the endpoint
# refuses with 503 — it is never open by accident. Vercel Cron sends this value
# automatically once it is set on the project.
CRON_SECRET=

# --- Hosted demo OTP ---
# Development-mock OTPs (the code is shown on screen, no SMS) are always on in
# development. On a production server they are refused unless you explicitly
# acknowledge it here. The response still says no SMS was sent.
ALLOW_DEV_OTP=false

# --- Database pool ---
# Connections per serverless instance (Neon's pooled endpoint multiplexes them).
DATABASE_POOL_MAX=3
