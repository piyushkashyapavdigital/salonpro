{
  "name": "@salonpro/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "seed": "tsx src/seed.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "seed:reset": "tsx src/seed.ts --reset",
    "bootstrap": "tsx src/seed.ts --bootstrap",
    "smoke": "node --import tsx --test test/smoke.test.ts"
  },
  "dependencies": {
    "@salonpro/shared": "*",
    "express": "^4.21.2",
    "node-cron": "^3.0.3",
    "pg": "^8.23.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
