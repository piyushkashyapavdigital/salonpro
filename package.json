{
  "name": "salonpro",
  "private": true,
  "version": "1.0.0",
  "description": "SalonPro — salon management platform (Next.js API on Vercel + customer & admin React Native apps)",
  "workspaces": [
    "packages/*",
    "apps/next"
  ],
  "scripts": {
    "dev": "npm --workspace @salonpro/next run dev",
    "build": "bash scripts/build-next.sh",
    "start": "npm --workspace @salonpro/next run start",
    "seed": "npm --workspace @salonpro/core run seed",
    "test": "npm --workspace @salonpro/shared run test && npm --workspace @salonpro/core run test && npm --workspace @salonpro/next run test",
    "test:api": "npm --workspace @salonpro/core run test",
    "test:next": "npm --workspace @salonpro/next run test",
    "test:shared": "npm --workspace @salonpro/shared run test",
    "typecheck": "npm --workspace @salonpro/core run typecheck && npm --workspace @salonpro/next run typecheck",
    "seed:reset": "npm --workspace @salonpro/core run seed:reset",
    "seed:bootstrap": "npm --workspace @salonpro/core run bootstrap",
    "test:smoke": "npm --workspace @salonpro/core run smoke",
    "mobile:sync": "bash scripts/sync-mobile-shared.sh",
    "mobile:apks": "bash scripts/build-mobile-apks.sh",
    "mobile:install": "bash scripts/install-apks.sh"
  },
  "engines": {
    "node": ">=22.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
