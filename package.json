{
  "name": "salonpro",
  "private": true,
  "version": "1.0.0",
  "description": "SalonPro — salon management platform (Next.js API on Vercel + customer & admin React Native apps)",
  "workspaces": [
    "packages/*",
    "apps/next"
  ],
  "scripts": {
    "dev": "bun --filter @salonpro/next dev",
    "build": "bash scripts/build-next.sh",
    "start": "bun --filter @salonpro/next start",
    "seed": "bun --filter @salonpro/core seed",
    "test": "bun --filter @salonpro/shared test && bun --filter @salonpro/core test && bun --filter @salonpro/next test",
    "test:api": "bun --filter @salonpro/core test",
    "test:next": "bun --filter @salonpro/next test",
    "test:shared": "bun --filter @salonpro/shared test",
    "typecheck": "bun --filter @salonpro/core typecheck && bun --filter @salonpro/next typecheck",
    "seed:reset": "bun --filter @salonpro/core seed:reset",
    "seed:bootstrap": "bun --filter @salonpro/core bootstrap",
    "test:smoke": "bun --filter @salonpro/core smoke",
    "mobile:sync": "bash scripts/sync-mobile-shared.sh",
    "mobile:apks": "bash scripts/build-mobile-apks.sh",
    "mobile:install": "bash scripts/install-apks.sh"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "trustedDependencies": [
    "esbuild"
  ]
}
